{
  "name": "tiny-assets-desktop",
  "productName": "Tiny Assets",
  "version": "0.1.6",
  "description": "Offline image compression with a floating drop zone and screenshot folder watching",
  "main": "build/main/index.cjs",
  "private": true,
  "scripts": {
    "start": "pnpm build:source && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config src/renderer",
    "test": "node --import tsx --test src/main/features/*/*.test.ts src/cli/*.test.ts src/shared/*.test.ts src/renderer/features/compression/formatting.test.ts scripts/packaging/*.test.ts",
    "build:source": "node --import tsx scripts/build.ts",
    "build": "pnpm typecheck && pnpm lint && node --import tsx scripts/build-app.ts",
    "test:native": "node --import tsx --test src/main/features/corner-drop/drag-monitor.native.integration.ts",
    "diagnose:notifications": "node --import tsx scripts/diagnose-notifications.ts",
    "qa:ui": "pnpm build:source && node --import tsx scripts/qa-ui.ts",
    "compress": "node --import tsx src/cli/index.ts",
    "install:app": "node --import tsx scripts/install-app.ts"
  },
  "dependencies": {
    "chokidar": "6.0.0",
    "koffi": "3.3.8",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1177.0",
    "@babel/core": "8.1.3",
    "@babel/eslint-parser": "8.1.2",
    "@electron/packager": "20.3.0",
    "@stylexjs/eslint-plugin": "0.19.2",
    "@stylexjs/stylex": "0.19.2",
    "@stylexjs/unplugin": "0.19.2",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.5.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "playwright": "1.65.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.23.0"
  }
}
